# ── Azure SQL ────────────────────────────────────────────────────────────────
DB_SERVER=smwe-sql.database.windows.net
DB_NAME=smwe
DB_USER=smweadmin
DB_PASSWORD=<set-in-keyvault>
DB_ENCRYPT=true
DB_TRUST_CERT=false

# ── Entra External ID (CIAM) ─────────────────────────────────────────────────
EXT_TENANT_ID=<smwe-external-tenant-id>
EXT_CLIENT_ID=<smwe-app-registration-client-id>
EXT_AUTHORITY=https://<smwe-tenant>.ciamlogin.com/<smwe-external-tenant-id>/v2.0

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDINGS_PROVIDER=huggingface
HF_TOKEN=<huggingface-api-token>
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIM=1024

# ── MCP server ───────────────────────────────────────────────────────────────
MCP_HTTP=0
MCP_SECRET=<shared-secret-for-hermes-roster>
PORT=3000

# ── Gap detection ────────────────────────────────────────────────────────────
SMWE_GAP_LOOKBACK_HOURS=24
SMWE_GAP_MIN_SIGNALS=2

# ── Cross-agent registry (Hermes) ────────────────────────────────────────────
SPE_MCP_URL=https://spe-api.azurewebsites.net/mcp
SPC_MCP_URL=https://spc-api.azurewebsites.net/mcp

# ── Paddle (payments) ────────────────────────────────────────────────────────
PADDLE_API_KEY=<paddle-api-key>
PADDLE_WEBHOOK_SECRET=<paddle-webhook-secret>
